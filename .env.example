# Voorbeeldinstellingen voor OAK. Kopieer naar .env en pas aan.
# .env staat in .gitignore: zet er nooit echte waarden in die in git terechtkomen.

# Adres waarop je OAK opent. Bepaalt ook de webhook-URL voor PGSharp en of cookies
# alleen via https worden verstuurd.
OAK_BASE_URL=http://localhost:8080

# Poort op de host.
OAK_HOST_PORT=8080

# Map op de host voor database, back-ups, Game Data en tijdelijk bewaarde exports.
OAK_DATA_PATH=./data

# Gebruiker en groep die eigenaar worden van de datamap. OAK draait nooit als root.
PUID=1000
PGID=1000

# Tijdzone voor weergave en logboek.
TZ=Europe/Amsterdam
OAK_TIMEZONE=Europe/Amsterdam

# Geheime sleutel voor sessies en vingerafdrukken, minimaal 32 tekens.
# Leeg laten mag: OAK maakt dan zelf een sleutel aan in de datamap.
# Zelf maken kan met: openssl rand -base64 48
OAK_SECRET_KEY=

# Netwerken van je reverse proxy, komma-gescheiden. Alleen hun X-Forwarded-headers
# worden vertrouwd. Leeg betekent: geen proxy vertrouwen.
OAK_TRUSTED_PROXY_CIDRS=

# Mogen nieuwe gebruikers zichzelf registreren? De eerste gebruiker wordt altijd eigenaar.
OAK_ALLOW_REGISTRATION=false

# Game Data automatisch bijwerken (PokeMiners en PvPoke).
OAK_GAMEDATA_AUTO_UPDATE=true

# Eventkalender automatisch bijwerken (LeekDuck.com via ScrapedDuck).
OAK_EVENTS_AUTO_UPDATE=true

# Hoeveel dagen een ontvangen export bewaard blijft voor diagnose en opnieuw verwerken.
OAK_RAW_IMPORT_RETENTION_DAYS=14

# DEBUG, INFO, WARNING of ERROR.
OAK_LOG_LEVEL=INFO

# Overige instellingen, met hun standaardwaarde. Haal het hekje weg om er een te wijzigen.
# Ze staan beschreven in docs/DEPLOYMENT.md.
# OAK_MAX_IMPORT_MB=64
# OAK_SESSION_IDLE_HOURS=168
# OAK_SESSION_MAX_DAYS=30
# OAK_LOGIN_MAX_ATTEMPTS=10
# OAK_LOGIN_WINDOW_MINUTES=15
# OAK_WEBHOOK_RATE_LIMIT_PER_HOUR=60
# OAK_GAMEDATA_UPDATE_INTERVAL_HOURS=24
# OAK_EVENTS_UPDATE_INTERVAL_HOURS=12
# OAK_SPRITE_URL_TEMPLATE=

# Kant-en-klare image gebruiken in plaats van zelf bouwen:
# OAK_IMAGE=ghcr.io/arjancool/oak-pogo:latest
