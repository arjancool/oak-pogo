# Later patterns win, so general rules come first and exceptions after them.

# Default for every text file, this file included. Without it, a name Git cannot classify by
# extension — `.gitattributes`, `.gitignore`, `LICENSE`, a `.gitkeep` — is still converted by
# `core.autocrlf`, which is how the guarantee below ends up being the only unguarded file in
# the repository. Binary content is detected and left alone by `text=auto`.
* text=auto eol=lf

# Text types are pinned to LF everywhere, so hashes of fixtures and documents are the same
# on every platform.
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf
*.toml text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.sh   text eol=lf
